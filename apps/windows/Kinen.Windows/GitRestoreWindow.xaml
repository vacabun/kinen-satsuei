<Window x:Class="Kinen.Windows.GitRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从 Git 恢复资料库" SizeToContent="Height" Width="510"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="SSH 仓库地址"/>
        <TextBox x:Name="Endpoint" Margin="0,5,0,14" AutomationProperties.Name="SSH 仓库地址"/>
        <TextBlock Text="分支"/>
        <TextBox x:Name="Branch" Text="main" Margin="0,5,0,14" AutomationProperties.Name="分支"/>
        <TextBlock Text="SSH 私钥文件"/>
        <DockPanel Margin="0,5,0,14">
            <Button DockPanel.Dock="Right" Content="选择…" Click="ChooseKey" Margin="8,0,0,0"/>
            <TextBox x:Name="KeyPath" IsReadOnly="True" AutomationProperties.Name="SSH 私钥文件"/>
        </DockPanel>
        <TextBlock Text="私钥口令（可选）"/>
        <PasswordBox x:Name="Passphrase" Margin="0,5,0,18" AutomationProperties.Name="私钥口令"/>
        <CheckBox x:Name="Remember" Content="将 SSH 连接和密钥保存到此资料库" Margin="0,0,0,12"/>
        <CheckBox x:Name="Attachments" Content="上传照片和视频附件" Visibility="Collapsed" Margin="0,0,0,12"/>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="返回" IsCancel="True"/>
            <Button x:Name="Confirm" Content="预览远端资料库" Margin="8,0,0,0" IsDefault="True" Click="Accept"/>
        </StackPanel>
    </StackPanel>
</Window>
