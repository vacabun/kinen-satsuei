<Window x:Class="Kinen.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="AppIcon.ico" Title="記念撮影" Width="1080" Height="700" MinWidth="760" MinHeight="490"
    Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontSize="14"
    AllowDrop="True" PreviewDragOver="FilesDragOver" Drop="FilesDropped" UseLayoutRounding="True" Loaded="WindowLoaded" Closed="WindowClosed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="280" MinWidth="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Canvas}" Padding="16,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="記念撮影" FontSize="25" FontWeight="Bold" Margin="4,0,0,22"/>
                <ListBox x:Name="Navigation" SelectionChanged="Navigate" Background="Transparent" VerticalAlignment="Top">
                    <ListBoxItem Content="笔记" Tag="notes" IsSelected="True"/>
                    <ListBoxItem Content="媒体" Tag="media"/>
                    <ListBoxItem Content="收藏" Tag="collection"/>
                    <ListBoxItem Content="资料库" Tag="library"/>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="12,16">
            <DockPanel>
                <TextBlock x:Name="ListTitle" DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="6,0,0,12"/>
                <TextBox x:Name="Query" DockPanel.Dock="Top" Margin="5,0,5,8" Padding="7"
                         AutomationProperties.Name="搜索" TextChanged="SearchChanged"/>
                <ComboBox x:Name="Subjects" DisplayMemberPath="Label" DockPanel.Dock="Top"
                          Margin="5,0,5,8" SelectionChanged="SubjectChanged" AutomationProperties.Name="成员或团体"/>
                <TextBlock x:Name="ListSummary" DockPanel.Dock="Top" Margin="6,0,0,8" Foreground="{StaticResource Quiet}"/>
                <Button x:Name="NewNoteButton" DockPanel.Dock="Top" Content="新建笔记" Click="NewNoteClicked"/>
                <Button x:Name="ImportButton" DockPanel.Dock="Top" Content="导入照片或视频…" Click="ImportClicked"/>
                <ListBox x:Name="Items" SelectionChanged="OpenItem" AutomationProperties.Name="记录">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Quiet}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Detail" Margin="28"/>
        </ScrollViewer>
    </Grid>
</Window>
