<Window x:Class="Kinen.Windows.MediaImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="导入媒体" Width="540" Height="620" MinWidth="450" MinHeight="460"
    WindowStartupLocation="CenterOwner" Closing="WindowClosing" FontSize="14">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" Foreground="{StaticResource Quiet}" Margin="0,8,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="关闭" Click="CancelClicked"/>
                <Button x:Name="SaveButton" Content="保存媒体" Click="SaveClicked" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Fields">
                <TextBlock x:Name="SelectionCount" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Image x:Name="Preview" MaxHeight="185" Stretch="Uniform" Margin="0,0,0,12"/>
                <StackPanel x:Name="KindSection">
                    <TextBlock Text="照片类型"/>
                    <ComboBox x:Name="Kind" DisplayMemberPath="Label" SelectionChanged="KindChanged"
                              AutomationProperties.Name="照片类型" Margin="0,5,0,10"/>
                </StackPanel>
                <StackPanel x:Name="SubjectsSection">
                    <TextBlock Text="选择成员或团体"/>
                    <ComboBox x:Name="Subjects" DisplayMemberPath="Label" AutomationProperties.Name="成员或团体" Margin="0,5,0,10"/>
                    <TextBlock Text="或新增成员或团体"/>
                    <TextBox x:Name="SubjectName" Padding="6" Margin="0,5,0,6" AutomationProperties.Name="新归属名称"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="新增成员" Click="AddMember"/>
                        <Button Content="新增团体" Click="AddGroup"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="拍摄日期" Margin="0,5,0,4"/>
                <DatePicker x:Name="CaptureDate" AutomationProperties.Name="拍摄日期"/>
                <TextBlock Text="回忆备注" Margin="0,10,0,4"/>
                <TextBox x:Name="MemoryNote" Padding="7" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" AutomationProperties.Name="回忆备注"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
