<Window x:Class="Kinen.Windows.NoteEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑笔记" Width="620" Height="660" MinWidth="460" MinHeight="480"
    WindowStartupLocation="CenterOwner" Closing="WindowClosing" FontSize="14">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="SaveStatus" Foreground="{StaticResource Quiet}" Margin="0,6,0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Discard" Content="丢弃草稿" Click="DiscardClicked"/>
                <Button Content="关闭" Click="CloseClicked"/>
                <Button Content="完成" Click="PublishClicked" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="标题" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleField" TextChanged="EditChanged" Padding="6"
                         AutomationProperties.Name="标题" Margin="0,0,0,12"/>
                <TextBlock Text="类型" Margin="0,0,0,4"/>
                <ComboBox x:Name="KindField" SelectionChanged="KindChanged" DisplayMemberPath="Label"
                          AutomationProperties.Name="类型" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="开始日期"/>
                        <DatePicker x:Name="StartDate" AutomationProperties.Name="开始日期" SelectedDateChanged="EditChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="EndDateRow">
                        <TextBlock Text="结束日期"/>
                        <DatePicker x:Name="EndDate" AutomationProperties.Name="结束日期" SelectedDateChanged="EditChanged"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="上级笔记" Margin="0,0,0,4"/>
                <ComboBox x:Name="ParentField" SelectionChanged="EditChanged" DisplayMemberPath="Label"
                          AutomationProperties.Name="上级笔记" Margin="0,0,0,12"/>
                <TextBlock Text="Markdown 正文" Margin="0,0,0,4"/>
                <TextBox x:Name="BodyField" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" Padding="8"
                         TextChanged="EditChanged" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Markdown 正文"/>
                <TextBlock Text="关联媒体（可多选）" Margin="0,14,0,4"/>
                <ListBox x:Name="MediaField" SelectionMode="Multiple" DisplayMemberPath="Label"
                         SelectionChanged="EditChanged" AutomationProperties.Name="关联媒体" MaxHeight="130"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
